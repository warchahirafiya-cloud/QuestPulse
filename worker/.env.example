# Internal URL of the deployed QuestPulse Node API (not GitHub Pages).
QUESTPULSE_API_URL=http://127.0.0.1:3000
# Generate a random secret of at least 32 characters; never commit a real value.
VIDEO_WORKER_TOKEN=replace-with-a-random-secret-of-at-least-32-characters
# MoneyPrinterTurbo API root, excluding /api/v1.
MPT_BASE_URL=http://127.0.0.1:8080
# Optional, only if MoneyPrinterTurbo has app.api_key configured.
MPT_API_KEY=
# Default uses Pexels. Configure its key in MoneyPrinterTurbo's own config.toml.
MPT_VIDEO_SOURCE=pexels
WORKER_POLL_SECONDS=10
MPT_POLL_SECONDS=8
MPT_TASK_TIMEOUT_SECONDS=2400
LOG_LEVEL=INFO
