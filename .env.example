NODE_ENV=development
PORT=3000
APP_ORIGIN=http://localhost:3000
DATABASE_PATH=./server/data/questpulse.sqlite
UPLOAD_DIR=./server/uploads
MAX_IMAGE_BYTES=5242880
MAX_VIDEO_BYTES=20971520
SESSION_DAYS=7
VIDEO_WORKER_TOKEN=replace-with-a-random-secret-of-at-least-32-characters
VIDEO_ARTIFACT_DIR=./server/private-video-artifacts
# MoneyPrinterTurbo API reachable from the video-worker container.
MPT_BASE_URL=http://host.docker.internal:8080
MPT_API_KEY=
MPT_VIDEO_SOURCE=pexels
WORKER_POLL_SECONDS=10
MPT_POLL_SECONDS=8
MPT_TASK_TIMEOUT_SECONDS=2400
LOG_LEVEL=INFO
